[Desktop Entry]
Name=Photos
Comment=Manage and browse your photo library
Comment[zh_CN]=管理和浏览照片图库
Exec=lingmo-photos %f
Icon=viewnior
Type=Application
Categories=Graphics;Photography;
MimeType=image/jpeg;image/png;image/webp;image/avif;image/gif;image/bmp;image/tiff;image/heic;image/heif;image/svg+xml;image/jxl;image/vnd.microsoft.icon;image/x-icon;
StartupWMClass=org.lingmo.Photos
